# Copy to deploy/env/prod.env on the server and adjust values as needed.
PROD_HTTP_PORT=8100
PROD_ALLOWED_HOSTS=demo.example.com
# Optional: override trusted CSRF origins (comma-separated, include scheme).
# PROD_CSRF_TRUSTED=https://demo.example.com
PROD_DJANGO_SECRET_KEY=replace-with-a-strong-secret
# Enable static asset collection during production deployments.
RUN_COLLECTSTATIC=1

# draw.io endpoints (set the public URL to HTTPS to avoid mixed content)
PROD_DRAWIO_BASE_URL=http://drawio:8080
PROD_DRAWIO_PUBLIC_URL=https://drawio.example.com
# Optional: tweak palettes or preload custom libraries
# PROD_DRAWIO_LIBS=general
# PROD_DRAWIO_CLIBS=http://web:8050/static/diagrams/mes-formes.xml
